# Mooltiproxy Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# REQUIRED: Master Proxy Key
# ============================================================================
# This is the master authentication key for the proxy
# Generate a secure key with: openssl rand -base64 32
MOOLTIPROXY_KEY=your_secure_master_key_here

# ============================================================================
# OPTIONAL: Proxy Configuration
# ============================================================================
# Port to expose the proxy on (default: 8000)
PROXY_PORT=8000

# ============================================================================
# OPTIONAL: Target API Keys
# ============================================================================
# Add your target API keys here
# The environment variable names should match what's in your config.yaml

# OpenAI API Key
# YOUR_OPENAI_API_KEY=sk-...

# Hugging Face API Key (if using TGI)
# YOUR_HF_API_KEY=hf_...

# Custom Target API Keys
# YOUR_CUSTOM_TARGET_KEY=...

# ============================================================================
# NOTES:
# ============================================================================
# 1. Never commit the .env file to version control
# 2. Use strong, randomly generated keys
# 3. Keep this file secure (chmod 600 .env)
# 4. Variable names must match config.yaml 'envkey' values
